class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int i = 0; 
        int j = numbers.size() - 1; 

        while(i < j){
            int temp = numbers[i] + numbers[j]; 
            if(temp == target){
                return {i + 1, j + 1}; //This is just because problem asks to be 1 index instead of usual 0 index
            }
            else if(temp > target) //If added together is larger, that means we need to go smaller 
                j--; 
            else if(temp < target) //If added sum is smaller, then need to go larger 
                i++;
        }
        return {0, 0}; 
    }
};